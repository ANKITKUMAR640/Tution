generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("BECC Administrator")
  role         String   @default("ADMIN")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model StudentUser {
  id           String            @id @default(cuid())
  email        String            @unique
  passwordHash String
  name         String
  phone        String
  active       Boolean           @default(true)
  attempts     PracticeAttempt[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model ContentBucket {
  id        String   @id @default(cuid())
  key       String   @unique
  data      Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model PracticeAttempt {
  id          String       @id
  userId      String?
  user        StudentUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail   String       @default("guest")
  setTitle    String
  data        Json
  completedAt DateTime     @default(now())
  createdAt   DateTime     @default(now())

  @@index([userId, completedAt])
  @@index([completedAt])
}
